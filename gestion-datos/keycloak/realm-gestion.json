{
  "realm": "gestion",
  "displayName": "Gestión de Datos Personales",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 900,
  "clients": [
    {
      "clientId": "gestion-frontend",
      "name": "Frontend - Gestión de Datos Personales",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:8080/*"],
      "webOrigins": ["http://localhost:8080"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/*"
      }
    },
    {
      "clientId": "gestion-tests",
      "name": "Cliente solo para pruebas automáticas (desarrollo)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true
    }
  ],
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "email": "demo@example.com",
      "emailVerified": true,
      "firstName": "Usuario",
      "lastName": "Demo",
      "credentials": [{ "type": "password", "value": "demo123", "temporary": false }]
    }
  ]
}
