server {
    listen 80;
    resolver 127.0.0.11 valid=5s;          # DNS interno de Docker: resuelve en cada petición,
    root /usr/share/nginx/html;            # así nginx arranca aunque "consultar" esté apagado.
    client_max_body_size 3m;

    # Configuración que lee el frontend al cargar (sin recompilar nada)
    location = /config.json {
        default_type application/json;
        add_header Cache-Control "no-store";
        return 200 '{"authEnabled": ${FRONT_AUTH_ENABLED}, "issuer": "${FRONT_OIDC_ISSUER}", "clientId": "${FRONT_OIDC_CLIENT}", "n8nUrl": "${FRONT_N8N_URL}"}';
    }

    location / { try_files $uri /index.html; }

    # /api/<servicio>/<ruta>  ->  http://<servicio>:8000/<ruta>
    location ~ ^/api/(crear|modificar|consultar|borrar|logs)/(.*)$ {
        set $svc $1;
        set $ruta $2;
        proxy_pass http://$svc:8000/$ruta$is_args$args;
        proxy_set_header Authorization $http_authorization;
        error_page 502 503 504 = @caido;
    }
    location @caido {
        default_type application/json;
        return 503 '{"detail":["El servicio no está disponible en este momento"]}';
    }
}
