{
  "id": "ingestaPersona01",
  "name": "01 - Ingesta de personas (RAG)",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "A1",
      "name": "Nota A1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -160
      ],
      "parameters": {
        "content": "## Flujo A: ingesta para el RAG\nLee las personas con el rol de solo lectura **n8n_ro**, construye un texto por persona (nombre, documento, fecha de nacimiento y género; sin correo ni celular), genera los embeddings y los guarda en la tabla **personas_vectores** (pgvector). Se reconstruye el índice completo en cada ejecución, así no se duplican personas.\nEjecútelo una vez con el disparador manual y luego **active** el flujo para que corra cada 15 minutos.",
        "height": 150,
        "width": 760
      }
    },
    {
      "id": "A2",
      "name": "Disparador manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        100
      ],
      "parameters": {}
    },
    {
      "id": "A3",
      "name": "Cada 15 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        280
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "A4",
      "name": "Reiniciar índice",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        260,
        190
      ],
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "DROP TABLE IF EXISTS personas_vectores;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "pgN8nRo00000001",
          "name": "Postgres n8n_ro (solo lectura)"
        }
      },
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "id": "A5",
      "name": "Leer personas",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        500,
        190
      ],
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "SELECT nro_documento,\n       concat_ws(' ', primer_nombre, segundo_nombre, apellidos) AS nombre_completo,\n       format('Persona: %s. Documento: %s %s. Fecha de nacimiento: %s. Género: %s.',\n              concat_ws(' ', primer_nombre, segundo_nombre, apellidos), tipo_documento, nro_documento,\n              to_char(fecha_nacimiento, 'YYYY-MM-DD'), genero) AS contenido\nFROM personas\nORDER BY nro_documento;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "pgN8nRo00000001",
          "name": "Postgres n8n_ro (solo lectura)"
        }
      },
      "executeOnce": true
    },
    {
      "id": "A6",
      "name": "Cargar en pgvector",
      "type": "@n8n/n8n-nodes-langchain.vectorStorePGVector",
      "typeVersion": 1.3,
      "position": [
        760,
        190
      ],
      "parameters": {
        "mode": "insert",
        "tableName": "personas_vectores",
        "embeddingBatchSize": 200,
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "pgN8nRo00000001",
          "name": "Postgres n8n_ro (solo lectura)"
        }
      }
    },
    {
      "id": "A7",
      "name": "Embeddings Gemini",
      "type": "@n8n/n8n-nodes-langchain.embeddingsGoogleGemini",
      "typeVersion": 1,
      "position": [
        700,
        420
      ],
      "parameters": {
        "modelName": "models/gemini-embedding-001"
      },
      "credentials": {
        "googlePalmApi": {
          "id": "geminiPersonas01",
          "name": "Google Gemini (PaLM) API"
        }
      }
    },
    {
      "id": "A8",
      "name": "Datos del documento",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1.1,
      "position": [
        900,
        420
      ],
      "parameters": {
        "dataType": "json",
        "jsonMode": "expressionData",
        "jsonData": "={{ $json.contenido }}",
        "textSplittingMode": "simple",
        "options": {
          "metadata": {
            "metadataValues": [
              {
                "name": "documento",
                "value": "={{ $json.nro_documento }}"
              },
              {
                "name": "nombre",
                "value": "={{ $json.nombre_completo }}"
              }
            ]
          }
        }
      }
    }
  ],
  "connections": {
    "Disparador manual": {
      "main": [
        [
          {
            "node": "Reiniciar índice",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Cada 15 minutos": {
      "main": [
        [
          {
            "node": "Reiniciar índice",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Reiniciar índice": {
      "main": [
        [
          {
            "node": "Leer personas",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Leer personas": {
      "main": [
        [
          {
            "node": "Cargar en pgvector",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Embeddings Gemini": {
      "ai_embedding": [
        [
          {
            "node": "Cargar en pgvector",
            "type": "ai_embedding",
            "index": 0
          }
        ]
      ]
    },
    "Datos del documento": {
      "ai_document": [
        [
          {
            "node": "Cargar en pgvector",
            "type": "ai_document",
            "index": 0
          }
        ]
      ]
    }
  }
}