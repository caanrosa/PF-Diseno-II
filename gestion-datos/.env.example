DB_NAME=personas_db
DB_USER=app
DB_PASSWORD=app_pass

# SSO. true = la interfaz y los microservicios exigen inicio de sesión en Keycloak
# (arrancar con --profile auth). false = modo desarrollo sin login.
AUTH_ENABLED=true
OIDC_ISSUER=http://localhost:8081/realms/gestion
JWKS_URL=http://keycloak:8080/realms/gestion/protocol/openid-connect/certs
